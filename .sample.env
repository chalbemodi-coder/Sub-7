# Mandatory Environment Variable

BOT_TOKEN=
API_ID=
API_HASH=
MONGO_SRV=
# Replace 0 with the owner's numeric Telegram user ID before using owner commands.
OWNER=0
# Configure main/log/backup/cloud/force-sub channels with /setchannel after startup.

# Optional Environment Variable

# Leave blank with Docker Compose: the bot creates a protected key in the persistent session-state volume on first /login.
# Set a stable Fernet key only for a host without persistent storage, or to reuse an existing encrypted session.
SESSION_ENCRYPTION_KEY=
# Legacy plaintext session; leave blank to use the encrypted /login flow.
SESSION=

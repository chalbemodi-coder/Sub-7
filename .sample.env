# Mandatory Environment Variable

BOT_TOKEN=
API_ID=
API_HASH=
MONGO_SRV=
# Replace 0 with the owner's numeric Telegram user ID before using owner commands.
OWNER=0
# Generate a Fernet key for encrypted session storage; required for /login.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this secret outside source control.
SESSION_ENCRYPTION_KEY=
# Configure main/log/backup/cloud/force-sub channels with /setchannel after startup.

# Optional Environment Variable

SESSION=
